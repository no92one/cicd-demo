    {
      "name": "create product",
      "item": [
        {
          "name": "Kolla att produkten inte redan finns",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Check product name\", function () {\r\n    var jsonData = pm.response.json();\r\n    for(let product of jsonData) {\r\n        if(product.name == \"TestProdukt\") {\r\n            pm.expect(false).to.be.true\r\n        }\r\n    }\r\n\r\n    pm.expect(true).to.be.true\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/products",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "New Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.environment.set(\"latest_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"TestProdukt\", \r\n    \"price\": 400\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/products",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "New Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/products/{{latest_id}}",
              "protocol": "http",
